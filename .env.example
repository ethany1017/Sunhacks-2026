# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Everything is optional: every service has an offline fallback.

# Claude reasoning (falls back to the deterministic planner without a key)
ANTHROPIC_API_KEY=
# empty = claude-haiku-5-5
ANTHROPIC_MODEL=

# Voice: the live server speaks every clearance (tower) and readback (pilot). VOICE=0 turns it off.
# Headless runs (tests, evaluation harness) never speak. Audio is cached in backend/audio_cache/;
# fill it before the demo with: cd backend && .venv/bin/python scripts/prewarm_audio.py
VOICE=1
# ElevenLabs voice ids (falls back to cached audio, then macOS `say`; pilot voices are picked per callsign)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_TOWER=
ELEVENLABS_VOICE_PILOT_1=
ELEVENLABS_VOICE_PILOT_2=
ELEVENLABS_VOICE_PILOT_3=
# empty = eleven_flash_v2_5
ELEVENLABS_MODEL=

# Simulator viewer (api/ + web/), only for watching the sim during sim work
# SCENARIO=sim/scenarios/kphx_smoke.json
# RUNS_DIR=runs

# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Everything is optional: every service has an offline fallback.

# Claude reasoning (falls back to the deterministic planner without a key)
ANTHROPIC_API_KEY=
# empty = claude-haiku-5-5
ANTHROPIC_MODEL=
# The evaluation harness (python -m app.evaluate, headless runs) always uses the planner's deterministic default so
# scores are repeatable and never need the network. CLAUDE_IN_HARNESS=1 lets Claude choose there too (sim time waits
# for each answer, at most 3 s).
CLAUDE_IN_HARNESS=0

# Voice: the live server speaks every clearance (tower) and readback (pilot). VOICE=0 turns it off.
# Headless runs (tests, evaluation harness) never speak. Audio is cached in backend/audio_cache/;
# fill it before the demo with: cd backend && .venv/bin/python scripts/prewarm_audio.py
VOICE=1
# ElevenLabs voice ids (falls back to cached audio, then macOS `say`; pilot voices are picked per callsign)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_TOWER=
ELEVENLABS_VOICE_PILOT_1=
ELEVENLABS_VOICE_PILOT_2=
ELEVENLABS_VOICE_PILOT_3=
# empty = eleven_flash_v2_5
ELEVENLABS_MODEL=

# Demo: the seed a dashboard run of each level starts on (the dashboard has no seed control). run_demo.sh defaults
# them to Light Rain 25 and Normal Day 3 (the shell, then this file, win); empty without run_demo.sh = the level's
# first training seed. Honesty note: these demo seeds were chosen from the training seeds as days where the two
# controllers differ (Light Rain 25: Human FAIL, Agent PASS); they are not a fair sample. The honest comparison is the
# multi-seed tables in the README. A held-out grading seed, a non-integer or a value outside 0..2147483647 is ignored with a
# warning in the backend log. The seed shows in the dashboard's status bar.
DEMO_SEED_NORMAL_DAY=
DEMO_SEED_LIGHT_RAIN=
# Sim seconds per wall second for the live server (run_demo.sh defaults to 10: a day takes about 4 minutes)
SIM_SPEED=10

# Simulator viewer (api/ + web/), only for watching the sim during sim work
# SCENARIO=sim/scenarios/kphx_smoke.json
# RUNS_DIR=runs

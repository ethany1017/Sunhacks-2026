# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Everything is optional: every service has an offline fallback.

# Claude reasoning (falls back to the deterministic planner without a key)
ANTHROPIC_API_KEY=
# empty = claude-haiku-5-5
ANTHROPIC_MODEL=

# ElevenLabs voice (falls back to cached audio, then macOS `say`)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_TOWER=
ELEVENLABS_VOICE_PILOT_1=
ELEVENLABS_VOICE_PILOT_2=

# Simulator viewer (api/ + web/), only for watching the sim during sim work
# SCENARIO=sim/scenarios/kphx_smoke.json
# RUNS_DIR=runs
